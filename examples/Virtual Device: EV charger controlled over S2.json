    {
        "id": "58616c2d2b070229",
        "type": "function",
        "z": "c4f1e2d3a5b6c7d8",
        "name": "Manual control -> real charger",
        "func": "// Changes made on the virtual charger from the GX or VRM (Manual mode) go to the real one.\nif (msg.topic === '/StartStop') return [{ payload: msg.payload }, null]\nif (msg.topic === '/SetCurrent') return [null, { payload: msg.payload }]\nreturn null\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
