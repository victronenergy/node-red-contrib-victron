        "type": "function",
        "z": "c4f1e2d3a5b6c7d8",
        "name": "Real -> virtual charger",
        "func": "// The input nodes are named after the path, so msg.topic is the virtual node's property name.\nreturn { payload: { [msg.topic]: msg.payload } }\n",
