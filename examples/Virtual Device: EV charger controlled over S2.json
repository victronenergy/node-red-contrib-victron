    {
        "id": "45ff2487e854b652",
        "type": "function",
        "z": "c4f1e2d3a5b6c7d8",
        "name": "Mode -> real charger, confirm on feedback",
        "func": "// Input 1: ModeInstruction from s2-resource. Input 2: /StartStop read back from the real charger.\n// Output 1: real /StartStop, output 2: real /SetCurrent, output 3: ModeConfirmation to s2-resource.\nconst PHASES = 3 // phases the real charger charges on, used to turn power into current\nconst VOLTAGE = 230\nconst MIN_A = 6\nconst MAX_A = 32\n\nif (msg.topic === 'StartStop') {\n  flow.set('realStartStop', msg.payload)\n  const pending = flow.get('pendingInstruction')\n  if (pending && pending.target === msg.payload) {\n    flow.set('pendingInstruction', null)\n    return [null, null, pending.confirm]\n  }\n  return null\n}\n\nif (msg.topic === 'ModeRequest') {\n  // No mode known yet: report what the real charger is doing now\n  const index = flow.get('realStartStop') === 1 ? 1 : 0\n  return [null, null, { topic: 'ModeConfirmation', cemId: msg.cemId, payload: { index } }]\n}\nif (msg.topic !== 'ModeInstruction') return null\n\nconst p = msg.payload\nconst power = Array.isArray(p.values) ? p.values.reduce((a, b) => a + b, 0) : (p.values || 0)\nconst target = power > 0 ? 1 : 0\nconst confirm = { topic: 'ModeConfirmation', cemId: msg.cemId, payload: p }\nconst setCurrent = target\n  ? { payload: Math.max(MIN_A, Math.min(MAX_A, Math.round(power / (PHASES * VOLTAGE)))) }\n  : null\n\nif (flow.get('realStartStop') === target) {\n  // Already there, so no /StartStop change will come back to confirm on\n  flow.set('pendingInstruction', null)\n  return [null, setCurrent, confirm]\n}\nflow.set('pendingInstruction', { target, confirm })\nreturn [{ payload: target }, setCurrent, null]\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
