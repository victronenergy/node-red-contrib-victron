[
    {
        "id": "pump-alert-comment",
        "type": "comment",
        "z": "6790bf584e10e175",
        "name": "Example: Alert when the water pump runs too long",
        "info": "Watches a relay driving a water pump. If it stays on for more than 5 minutes without switching off in between, an event is injected into the VRM portal Event logs tab so the long run shows up in the installation's history, not just in a Node-RED debug pane.",
        "x": 230,
        "y": 460,
        "wires": []
    },
