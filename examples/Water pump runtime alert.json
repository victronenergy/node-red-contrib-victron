    {
        "id": "pump-runtime-tracker",
        "type": "function",
        "z": "6790bf584e10e175",
        "name": "Track pump runtime",
        "func": "const RUNTIME_LIMIT_MS = 5 * 60 * 1000;\nconst timer = context.get('timer');\n\nif (msg.payload === 1) {\n    if (!timer) {\n        context.set('timer', setTimeout(() => {\n            node.send({\n                payload: 'Water pump has been running for more than 5 minutes',\n                severity: 0,\n                app: 'pump-monitor'\n            });\n            context.set('timer', null);\n        }, RUNTIME_LIMIT_MS));\n    }\n} else if (timer) {\n    clearTimeout(timer);\n    context.set('timer', null);\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "clearTimeout(context.get('timer'));",
        "libs": [],
        "x": 320,
        "y": 560,
        "wires": [
            [
                "pump-runtime-event"
            ]
        ]
    },
