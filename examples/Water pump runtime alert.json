        "type": "victron-input-switch",
        "z": "6790bf584e10e175",
        "outputs": 1,
        "service": "com.victronenergy.switch/100",
        "path": "/SwitchableOutput/output_1/State",
        "serviceObj": {
            "service": "com.victronenergy.switch/100",
            "name": "Virtual pump",
            "communityTag": "switch"
        },
        "pathObj": {
            "path": "/SwitchableOutput/output_1/State",
            "type": "enum",
            "enum": {
                "0": "Off",
                "1": "On"
            },
            "name": "Pump state",
            "mode": "both"
        },
        "name": "Pump relay",
        "onlyChanges": true,
        "conditionalMode": false,
        "condition1HysteresisEnabled": false,
        "condition1HysteresisThreshold": "",
        "outputTrue": "",
        "outputFalse": "",
