    "name": "Kick off loop",
    "func": "flow.set('loopActive', true)\nsetTimeout(() => {\n    flow.set('loopActive', false)\n    // let in-flight echoes drain before leaving the relay open\n    setTimeout(() => node.send({ payload: 0 }), 500)\n}, 3000)\n// two writes in flight at once: the loop keeps echoing both\nreturn [[{ payload: 1 }, { payload: 0 }]]",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "flow.set('loopActive', false)",
